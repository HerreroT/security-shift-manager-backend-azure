# Copy this file to .env and change the values before running docker compose.

DB_USERNAME=shiftmanager
DB_PASSWORD=change-me

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-with-a-long-random-secret-of-32-chars-or-more

# First administrator, created only when the database has no users.
ADMIN_EMAIL=admin@shiftmanager.com
ADMIN_PASSWORD=change-me

# true loads example guards, services and shifts (only if there are no guards yet).
SEED_DEMO_DATA=false

# Port published on the host.
PORT=8090
