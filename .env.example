# Copy this file to .env and change the values before running docker compose.
# .env is in .gitignore: never commit real secrets.
# Generate random values in PowerShell with:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))

# PostgreSQL user and password (the database is created on the first start).
DB_USERNAME=shiftmanager
DB_PASSWORD=change-me

# JWT signing key, at least 32 characters. Token lifetime in milliseconds (24 h).
JWT_SECRET=change-me-with-a-long-random-secret-of-32-chars-or-more
JWT_EXPIRATION_MS=86400000

# First administrator, created only when the database has no users.
ADMIN_EMAIL=admin@shiftmanager.com
ADMIN_PASSWORD=change-me

# true loads example guards, services and shifts (only if there are no guards yet).
SEED_DEMO_DATA=false

# Comma separated origins allowed by CORS (Expo web). Native apps do not need it.
CORS_ALLOWED_ORIGINS=*

# Port published on the host and tag of the local image.
PORT=8090
APP_VERSION=local
